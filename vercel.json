{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "tanstack-start",
  "nodeVersion": "18.x",
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "dist/server/index.js": {
      "runtime": "nodejs18.x",
      "memory": 3008,
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/dist/server/index.js",
      "methods": ["GET", "HEAD", "PUT", "PATCH", "POST", "DELETE"]
    }
  ]
}
